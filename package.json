{
  "name": "sijord",
  "version": "0.1.0",
  "private": true,
  "description": "A co-op open world monster-catching adventure game.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "tsx src/server/index.ts",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:single": "tsc --noEmit && vite build --mode single && node -e \"require('fs').renameSync('dist-single/index.html','dist-single/sijord.html')\"",
    "relay": "node -e \"import('@trystero-p2p/ws-relay/server').then(m=>{m.createWsRelayServer({port:Number(process.env.PORT||8090)});console.log('relay on',process.env.PORT||8090)})\""
  },
  "dependencies": {
    "@trystero-p2p/ws-relay": "^0.26.0",
    "three": "^0.186.1",
    "trystero": "^0.26.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.2",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.3"
  }
}
